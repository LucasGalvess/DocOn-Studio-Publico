# Copie para o painel de variáveis da hospedagem (ou exporte antes de "npm start"). Nunca versione o arquivo com valores.
ANTHROPIC_API_KEY=            # console.anthropic.com › API keys (cobrança separada do plano do claude.ai)
DOCON_EQUIPE=Lucas:troque-esta-senha,Ana:outra-senha   # quem entra no Studio (nome:senha, separados por vírgula)
DOCON_SEGREDO=                # texto longo e aleatório: assina o login (ex.: openssl rand -hex 32)
DOCON_DATA=/data              # pasta persistente (banco + arquivos). Na hospedagem, um disco permanente
DOCON_HTTPS=1                 # cookies só por HTTPS (deixe 1 em produção)
DOCON_MODELO=claude-opus-5-5  # modelo do diretor e do agente
# Agente de edição na nuvem (etapa 2: render pelo site). Gere os ids com "npm run agente".
DOCON_AGENTE_ID=
DOCON_AMBIENTE_ID=
DOCON_AGENTE_ESFORCO=high     # raciocínio do agente: low, medium, high, xhigh, max
DOCON_GITHUB_TOKEN=           # token fine-grained só com leitura do repositório docon-studio
DOCON_REPO=https://github.com/LucasGalvess/DocOn-Studio
# Voz da DocOn: "kokoro" (padrão, gratuita, roda no servidor) · "azure" ou "elevenlabs" (pagas, opcionais)
VOZ_PROVEDOR=kokoro
VOZ_EFEITO=docon
# Mídia online e IA (opcionais; cada fonte só aparece se a chave existir; Openverse dispensa chave)
MAGNIFIC_API_KEY=             # magnific.com › API (a mesma chave da Freepik funciona); busca, downloads e geração com IA
PEXELS_API_KEY=               # pexels.com/api (grátis)
PIXABAY_API_KEY=              # pixabay.com/api/docs (grátis)
FREESOUND_API_KEY=            # freesound.org/apiv2/apply (grátis; só CC0 e CC-BY entram)
